# Copy this file to .env and fill only the services you use.
# Never commit .env or real credentials.

CONCEPTSCAPE_GEMINI_API_KEY=
CONCEPTSCAPE_GROQ_API_KEY=
CONCEPTSCAPE_DATABASE_URL=sqlite:///./conceptscape.db
CONCEPTSCAPE_JWT_SECRET=generate-a-long-random-secret
CONCEPTSCAPE_JWT_ACCESS_MINUTES=60
CONCEPTSCAPE_ENVIRONMENT=development
CONCEPTSCAPE_PIPELINE_EXECUTION_MODE=inline
CONCEPTSCAPE_RATE_LIMIT_PER_MINUTE=120
CONCEPTSCAPE_REDIS_URL=
CONCEPTSCAPE_SENTRY_DSN=
CONCEPTSCAPE_CLAMAV_HOST=
CONCEPTSCAPE_CLAMAV_PORT=3310
POSTGRES_PASSWORD=change-this-before-compose

# Optional remote graph store. Leave empty to use the configured fallback.
CONCEPTSCAPE_NEO4J_URI=
CONCEPTSCAPE_NEO4J_USER=neo4j
CONCEPTSCAPE_NEO4J_PASSWORD=
CONCEPTSCAPE_NEO4J_DATABASE=neo4j

# Optional remote vector store. Leave empty for embedded local mode.
CONCEPTSCAPE_QDRANT_URL=
CONCEPTSCAPE_QDRANT_API_KEY=
CONCEPTSCAPE_QDRANT_PATH=qdrant_data
CONCEPTSCAPE_EMBEDDING_MODEL=sentence-transformers/multi-qa-MiniLM-L6-cos-v1
CONCEPTSCAPE_QDRANT_ALLOW_LOCAL_FALLBACK=true

# Local development defaults.
CONCEPTSCAPE_API_HOST=127.0.0.1
CONCEPTSCAPE_API_PORT=8000
CONCEPTSCAPE_API_ALLOWED_ORIGINS=["http://localhost:3000"]
