CONCEPTSCAPE_ENVIRONMENT=production
CONCEPTSCAPE_DATABASE_URL=postgresql+psycopg://conceptscape:REPLACE@postgres:5432/conceptscape
CONCEPTSCAPE_PIPELINE_EXECUTION_MODE=worker
CONCEPTSCAPE_QDRANT_URL=http://qdrant:6333
CONCEPTSCAPE_QDRANT_ALLOW_LOCAL_FALLBACK=false
CONCEPTSCAPE_API_ALLOWED_ORIGINS=["https://app.example.com"]
CONCEPTSCAPE_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
